# 用户端前端环境变量模板（Vite）
# 复制为 frontend/.env（或 .env.development / .env.production）

VITE_APP_NAME=多客陪玩
VITE_VERSION=1.0.0

# WebSocket / Socket.io 服务地址
VITE_SOCKET_URL=http://localhost:3000
VITE_WEBSOCKET=http://localhost:3000
VITE_UPLOAD_URL=http://localhost:3000

# 腾讯云 COS（公开读桶，前端直传用）
VITE_COS_BUCKET=
VITE_COS_REGION=ap-guangzhou

# 腾讯云 IM SDK
VITE_SDK_APP_ID=

# WebRTC TURN 中继（对称 NAT / 严格防火墙环境必需；不配置则仅走 STUN）
# 示例：VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# 地图 Key（高德 / 腾讯）
VITE_AMAP_KEY=
VITE_QQMAP_KEY=

# App 端 API 绝对地址（H5 同源部署留空；App 打包时填 https://你的域名）
VITE_API_ORIGIN=

# 1=启用 App 原生 WebRTC 插件（需 HBuilderX 自定义基座/真机验证；默认关闭）
VITE_USE_NATIVE_CALL=0
