# 用户端前端环境变量模板（Vite）
# 复制为 frontend/.env（或 .env.development / .env.production）

VITE_APP_NAME=多客陪玩
VITE_VERSION=1.0.0

# WebSocket / Socket.io 服务地址
VITE_SOCKET_URL=http://localhost:3000
VITE_WEBSOCKET=http://localhost:3000
VITE_UPLOAD_URL=http://localhost:3000

# 腾讯云 COS（公开读桶，前端直传用）
VITE_COS_BUCKET=
VITE_COS_REGION=ap-guangzhou

# 腾讯云 IM SDK
VITE_SDK_APP_ID=

# 地图 Key（高德 / 腾讯）
VITE_AMAP_KEY=
VITE_QQMAP_KEY=
