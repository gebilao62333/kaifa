# ===== 生产环境配置 =====
# 同源部署时使用相对路径，由 nginx 统一代理到后端

# API 基础路径（前端所有 /api/* 请求由此前缀发起）
VITE_API_BASE=/api

# Socket.IO 连接地址（空字符串 = 同源连接，由 nginx 代理 /socket.io/）
VITE_SOCKET_URL=

# 备用 WebSocket 路径
VITE_WEBSOCKET=

# 文件上传端点
VITE_UPLOAD_URL=/api/upload/file

# 腾讯云 TRTC/IM 应用 ID
# 必须替换：不要提交真实/示例值，构建前请由 CI/CD 或部署环境注入 VITE_SDK_APP_ID，
# 留空会导致 SDKAppID=0、IM/TRTC 不可用。
VITE_SDK_APP_ID=

# 腾讯云 COS 对象存储
# 必须替换：不要提交真实桶名/密钥，构建前请由 CI/CD 或部署环境注入
# VITE_COS_BUCKET / VITE_COS_REGION，留空会导致上传指向错误或失败。
VITE_COS_BUCKET=
VITE_COS_REGION=ap-guangzhou

# WebRTC TURN 中继（对称 NAT / 严格防火墙环境必需）
# 不配置时仅使用公共 STUN；如需中继请由部署环境注入以下变量。
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# 应用元信息
VITE_APP_NAME=多客陪玩
VITE_VERSION=3.0.0

# TRTC SDK（官方 CDN，可按需替换为自建 CDN 地址）
#VITE_TRTC_SDK_URL=https://web.sdk.qcloud.com/trtc/webrtc/v5/dist/trtc.js
