# ===== 生产环境配置 =====
# 同源部署时使用相对路径，由 nginx 统一代理到后端

# API 基础路径（前端所有 /api/* 请求由此前缀发起）
VITE_API_BASE=/api

# Socket.IO 连接地址（空字符串 = 同源连接，由 nginx 代理 /socket.io/）
VITE_SOCKET_URL=

# 备用 WebSocket 路径
VITE_WEBSOCKET=

# 文件上传端点
VITE_UPLOAD_URL=/api/upload/file

# 腾讯云 TRTC/IM 应用 ID（生产环境请替换为实际值）
VITE_SDK_APP_ID=1400745478

# 腾讯云 COS 对象存储（生产环境请替换为实际值）
VITE_COS_BUCKET=your-bucket-1250000000
VITE_COS_REGION=ap-guangzhou

# 应用元信息
VITE_APP_NAME=多客陪玩
VITE_VERSION=3.0.0
