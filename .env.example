# ============================================
# 多客陪玩平台 - 环境变量模板（根目录）
# 复制为 .env 后填入真实值；含敏感信息，.env 已被 .gitignore 忽略
# docker-compose.yml 通过 env_file 加载本文件
# ============================================

# --- 服务 ---
PORT=3000
NODE_ENV=development

# --- 应用 ---
APP_NAME=多客陪玩
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- 数据库（docker-compose 内容器名，本地开发改为 127.0.0.1:3307）---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eudazi
DB_USER=admin
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
DB_POOL_MAX=10
DB_POOL_MIN=0

# --- MySQL 容器初始化（docker-compose 服务变量）---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=eudazi
MYSQL_USER=admin
MYSQL_PASSWORD=changeme

# --- MongoDB ---
MONGO_URI=mongodb://admin:changeme@mongo:27017/eudazi?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
# 应用账号（mongo/init.js 创建；compose 启动必需）
MONGO_APP_USER=eudazi
MONGO_APP_PASSWORD=changeme-mongo-app-password
MONGO_DATABASE=eudazi

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# --- JWT 认证 ---
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_TOKEN=changeme
# 应急登录：仅当 true 时数据库不可用才允许 ADMIN_USERNAME/ADMIN_PASSWORD 登录（默认关闭）
ADMIN_EMERGENCY_LOGIN=false

# --- 限流 ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# 认证黑名单查询失败时的策略：closed=拒绝请求（生产推荐）/ open=放行（本地开发默认）
AUTH_BLACKLIST_FAIL_MODE=closed
# 分享奖励每人每日上限（防刷）
SHARE_REWARD_DAILY_LIMIT=10

# --- 对象存储（腾讯云 COS）---
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# --- 微信支付 ---
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=

# 微信登录（第三方登录用，必须配置，否则 /api/user/login-third 直接拒绝）
# 注意：这是小程序/公众号的 AppSecret，不是支付 API 密钥
WECHAT_APPSECRET=

# Apple 登录受众（iOS Bundle ID 或 Service ID；配置后会校验 identityToken 的 aud）
APPLE_CLIENT_ID=

# ⚠️ 仅本地联调：接受未经服务端反查的支付回执（默认关闭，生产严禁开启）
ALLOW_UNVERIFIED_PAY_CALLBACK=false

# ⚠️ 仅受控排障：跳过生产环境密钥强制校验（默认关闭，生产严禁开启）
ALLOW_INSECURE_CONFIG=false

# --- 腾讯云短信 ---
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=

# --- 通话通道（自建 WebRTC 为主，腾讯云 TRTC 为备选）---
# webrtc（默认）| trtc（需同时配置下面的 TRTC_APP_ID/SECRET_KEY）
CALL_CHANNEL=webrtc
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- TURN 中继（docker compose --profile turn 时使用）---
# 与 backend/.env 的 TURN_SECRET 必须一致；采用 coturn REST API 模式，前端不持有长期密钥
TURN_REALM=eudazi
TURN_SECRET=
TURN_EXTERNAL_IP=

# --- 腾讯云 TRTC 音视频（仅 CALL_CHANNEL=trtc 时需要）---
TRTC_APP_ID=
TRTC_SECRET_KEY=

# --- 日志与调试 ---
LOGS_PATH=./logs
LOG_TO_CONSOLE=false
USE_MOCK_DB=false
