# ============================================
# 多客陪玩平台 - 环境变量模板（根目录）
# 复制为 .env 后填入真实值；含敏感信息，.env 已被 .gitignore 忽略
# docker-compose.yml 通过 env_file 加载本文件
# ============================================

# --- 服务 ---
PORT=3000
NODE_ENV=development
# 后端对外地址；支付回调、分享链接等按它拼接（本地默认 http://localhost:3000）
SERVER_URL=http://localhost:3000

# --- 应用 ---
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- 数据库（docker-compose 内容器名，本地开发改为 127.0.0.1:3307）---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eudazi
DB_USER=admin
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
DB_POOL_MAX=10
DB_POOL_MIN=0

# --- MySQL 容器初始化（docker-compose 服务变量）---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=eudazi
MYSQL_USER=admin
MYSQL_PASSWORD=changeme

# --- MongoDB ---
MONGO_URI=mongodb://admin:changeme@mongo:27017/eudazi?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
# 应用账号（mongo/init.js 创建；compose 启动必需）
MONGO_APP_USER=eudazi
MONGO_APP_PASSWORD=changeme-mongo-app-password
MONGO_DATABASE=eudazi

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# --- JWT 认证 ---
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# 管理端访问令牌时效（审计 M-2：默认 12h；后台权限/状态每次请求实时回读数据库，这里决定凭令牌本身还能活多久）
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_TOKEN=changeme
# 管理端令牌独立签名密钥（审计 M-3）。留空时由 JWT_SECRET 派生一个不同的密钥——两类令牌已互不通用，
# 但掌握 JWT_SECRET 者仍可推出该派生值；需要「用户端密钥泄露也不影响管理端」时请显式填一个强随机值
ADMIN_JWT_SECRET=
# 应急登录：仅当 true 时数据库不可用才允许 ADMIN_USERNAME/ADMIN_PASSWORD 登录（默认关闭）
ADMIN_EMERGENCY_LOGIN=false
# 应急登录账号（仅 ADMIN_EMERGENCY_LOGIN=true 且数据库不可用时生效；登录后请立即创建正式管理员并关闭开关）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 实名信息（真实姓名/身份证号/正反面照）静态加密密钥（审计 M-8）。
# 生成命令：openssl rand -hex 32。留空时非生产环境按明文存储并告警，生产环境拒绝启动。
# ⚠️ 配置本键前必须先执行迁移 backend/src/migrations/20261004000002_widen_pii_columns.js
#    （加宽 xn_user 的 real_name/id_card/正反面照列，否则密文写入会被截断）。
# ⚠️ 本键投入生产后不可随意更换：换键后历史密文无法解密（无密钥轮换机制，属遗留）。
PII_ENCRYPTION_KEY=

# --- 限流 ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# 后台登录单 IP 每 15 分钟的尝试次数（审计 H-3）
ADMIN_LOGIN_RATE_LIMIT_MAX=5
# 同一管理员账号连续失败多少次后锁定 15 分钟（审计 H-3）
ADMIN_LOGIN_MAX_FAILS=5
# 用户端登录单 IP 每 15 分钟允许的尝试次数（审计 M11）
LOGIN_RATE_LIMIT_MAX=20
# 验证码发送单 IP 每分钟次数（审计 H-8：开发环境不再自动豁免限流，本地联调频繁发码时调大此项）
SMS_RATE_LIMIT_MAX=1
# 一键放行全部限流，仅用于本地压测/排障（审计 H-8：生产环境设为 true 时后端直接拒绝启动）
RATE_LIMIT_DISABLED=false

# --- 反向代理信任层级（审计 H-8）---
# 所有「按 IP 计」的限流与访问日志都取 req.ip，而 req.ip 是否采信 X-Forwarded-For
# 完全由本项决定；该请求头客户端可随意伪造，因此默认只信任回环地址。
# 可用取值：loopback / linklocal / unixsocket 及其组合、单个跳数 1~10、IP 或 CIDR 网段（逗号分隔）；
# false=完全忽略 X-Forwarded-For（后端直接暴露给客户端时用）。
# 禁止填 true / 星号 / all（等于允许任意直连客户端伪造 IP 绕过限流），配置解析层会拒绝启动。
#
# ⚠️ 本文件是 docker-compose.yml 的插值来源，而 compose 已经给 backend 注入了
#    TRUST_PROXY=${TRUST_PROXY:-loopback,172.16.0.0/12}（该编排里 nginx 是另一个容器，
#    走 eudazi_net 的 bridge 网段，只信任回环会让全站共用一个限流桶）。
#    在这里取消注释并写 loopback 会**覆盖掉那个默认值**，把 compose 部署的限流口径改坏，
#    所以标准 compose 部署请保持本键不设置。
# 只有以下两种情况才取消注释：
#   ①不用 compose、后端与 nginx 同机手工部署 → TRUST_PROXY=loopback（代码默认值，写不写都行）
#   ②反代在别处（云 LB / K8s ingress / 跨机 nginx）→ 显式写反代网段，如 TRUST_PROXY=10.0.0.0/8
# TRUST_PROXY=loopback

# 认证黑名单查询失败时的策略：closed=拒绝请求（生产推荐）/ open=放行（本地开发默认）
AUTH_BLACKLIST_FAIL_MODE=closed
# 分享奖励每人每日上限（防刷）
SHARE_REWARD_DAILY_LIMIT=10

# --- 对象存储（COS / 七牛 / 阿里云 OSS，多家可组合：逗号分隔按优先级，本地开发可全部留空）---
STORAGE_PROVIDER=cos
# 链首失败是否继续尝试下一家（默认 true）；false=失败即报错
STORAGE_FALLBACK=true
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_DOMAIN=

# --- 微信支付 ---
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=
# 商户平台「异步通知地址」必须指向本服务的 /api/pay/wx-notify（不是 /wx-callback）；留空按 SERVER_URL 自动拼接
WECHAT_NOTIFY_URL=
# 微信支付 API 证书路径（退款等双向证书接口需要；容器部署放 /app/cert/wechat/）
WECHAT_CERT_PATH=

# 微信登录（第三方登录用，必须配置，否则 /api/user/login-third 直接拒绝）
# 注意：这是小程序/公众号的 AppSecret，不是支付 API 密钥
WECHAT_APPSECRET=

# Apple 登录受众（iOS Bundle ID 或 Service ID；配置后会校验 identityToken 的 aud）
APPLE_CLIENT_ID=

# --- 支付宝 ---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ⚠️ 仅本地联调：接受未经服务端反查的支付回执（默认关闭，生产严禁开启）
ALLOW_UNVERIFIED_PAY_CALLBACK=false

# ⚠️ 仅受控排障：按项豁免生产环境强制校验（逗号分隔的「检查项名」；留空或 false 表示不豁免）
# 可豁免项：JWT_SECRET, DB_PASSWORD, ADMIN_TOKEN, ADMIN_JWT_SECRET, PII_ENCRYPTION_KEY
# 不可豁免（始终强制）：CORS_ORIGIN, USE_MOCK_DB, RATE_LIMIT_DISABLED
# 注意：true/1/all/* 已不再表示「整体跳过」，会被拒绝且不豁免任何项；正常部署请保持 false
ALLOW_INSECURE_CONFIG=false

# --- 腾讯云短信 ---
# 验证码/通知模板号必须在腾讯云控制台申请后填写，缺一即发送失败（登录、注册、重置密码都依赖验证码）
# 注意：控制台的 SDKAppID 填在 SMS_APP_ID（代码只读这一个键，没有 SMS_SDK_APP_ID）
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=
SMS_TEMPLATE_ID=
SMS_NOTIFY_TEMPLATE_ID=

# --- 通话通道（自建 WebRTC 为主，腾讯云 TRTC 为备选）---
# webrtc（默认）| trtc（需同时配置下面的 TRTC_APP_ID/SECRET_KEY）
CALL_CHANNEL=webrtc
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- TURN 中继（docker compose --profile turn 时使用）---
# 采用 coturn REST API 模式（--use-auth-secret）：凭据由后端按用户临时签发，前端不持有长期密钥。
# ⚠️ 启用 turn profile 前必须把 TURN_SECRET 换成强随机值（openssl rand -hex 32）：
#    未设置时 coturn 会以 compose 里的公开占位密钥启动，任何人都能据此冒签中继凭据；
#    该值经 env_file 同时注入 backend 用于签发凭据，两处必须一致。
TURN_REALM=eudazi
TURN_SECRET=
TURN_EXTERNAL_IP=
# 后端签发给前端的 TURN 地址与凭据有效期（秒）；留空则前端仅用 STUN、不走中继
TURN_URL=
TURN_TTL=3600

# --- 腾讯云 TRTC 音视频（仅 CALL_CHANNEL=trtc 时需要）---
TRTC_APP_ID=
TRTC_SECRET_KEY=

# --- LLM 智能对话（虚拟用户）---
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
LLM_MAX_CONTEXT_MESSAGES=20

# --- 虚拟人 ---
VIRTUAL_USER_CHAT_HISTORY_LIMIT=200

# --- 日志与调试 ---
LOGS_PATH=./logs
LOG_TO_CONSOLE=false
USE_MOCK_DB=false
# 启动时自动执行迁移（默认执行；e2e 脚本等场景设 false 跳过）
AUTO_MIGRATE=true
# Swagger 文档：非 production 环境默认开启；生产需显式 true 才暴露 /api-docs
ENABLE_SWAGGER=false
# Swagger 文档中展示的生产服务器地址（仅文档用途）
SWAGGER_PROD_URL=https://api.eudazi.com
# 路由加载严格模式：任一业务路由模块加载失败即终止启动（生产建议 true）
STRICT_ROUTES=false

# --- 备份脚本（backend/scripts/backup.js，可选覆盖；默认存 backend/backups、保留 7 天）---
#BACKUP_DIR=./backups
#BACKUP_MODE=docker
#BACKUP_TARGET=all
#BACKUP_RETENTION_DAYS=7
