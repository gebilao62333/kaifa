# ============================================
# 多客陪玩平台 - 环境变量模板（根目录）
# 复制为 .env 后填入真实值；含敏感信息，.env 已被 .gitignore 忽略
# docker-compose.yml 通过 env_file 加载本文件
# ============================================

# --- 服务 ---
PORT=3000
NODE_ENV=development

# --- 应用 ---
APP_NAME=多客陪玩
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- 数据库（docker-compose 内容器名，本地开发改为 127.0.0.1:3307）---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eudazi
DB_USER=admin
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
DB_POOL_MAX=10
DB_POOL_MIN=0

# --- MySQL 容器初始化（docker-compose 服务变量）---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=eudazi
MYSQL_USER=admin
MYSQL_PASSWORD=changeme

# --- MongoDB ---
MONGO_URI=mongodb://admin:changeme@mongo:27017/eudazi?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DATABASE=eudazi

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# --- JWT 认证 ---
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_TOKEN=changeme

# --- 限流 ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# --- 对象存储（腾讯云 COS）---
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# --- 微信支付 ---
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=

# --- 腾讯云短信 ---
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=

# --- 腾讯云 TRTC 音视频 ---
TRTC_APP_ID=
TRTC_SECRET_KEY=

# --- 日志与调试 ---
LOGS_PATH=./logs
LOG_TO_CONSOLE=false
USE_MOCK_DB=false
