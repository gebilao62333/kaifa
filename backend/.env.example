# 后端环境变量模板
# 本地开发：复制为 backend/.env（server.js 从 backend/.env 加载）
# Docker 部署：由根目录 .env 通过 env_file 注入，无需此文件
# DB_HOST 等容器地址（mysql/redis/mongo）仅 Docker 内有效，本地开发改为 127.0.0.1（端口见 docker-compose.yml 映射）

PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=eudazi
DB_USER=admin
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
DB_POOL_MAX=10
DB_POOL_MIN=0

# ---- MongoDB ----
MONGO_URI=mongodb://admin:changeme@127.0.0.1:27017/eudazi?authSource=admin

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=changeme

# ---- JWT / Auth ----
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# 管理端访问令牌时效（审计 M-2：默认 12h；后台权限/状态每次请求实时回读数据库，这里决定凭令牌本身还能活多久，支持 s/m/h/d）
ADMIN_JWT_EXPIRES_IN=12h
# 管理端令牌独立签名密钥（审计 M-3）。留空时由 JWT_SECRET 派生一个不同的密钥——两类令牌已互不通用，
# 但掌握 JWT_SECRET 者仍可推出该派生值；需要「用户端密钥泄露也不影响管理端」时请显式填一个强随机值
ADMIN_JWT_SECRET=
ADMIN_TOKEN=changeme
# 应急登录：仅当设为 true 且数据库不可用时，才允许用下面的 ADMIN_USERNAME/ADMIN_PASSWORD 登录（默认关闭，生产慎用）
ADMIN_EMERGENCY_LOGIN=false
# 应急登录账号（登录后请立即创建正式管理员并关闭开关；注意不是 ADMIN_TOKEN）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 实名信息（真实姓名/身份证号/正反面照）静态加密密钥（审计 M-8）。
# 生成命令：openssl rand -hex 32。留空时非生产环境按明文存储并告警，生产环境拒绝启动。
# ⚠️ 配置本键前必须先执行迁移 backend/src/migrations/20261004000002_widen_pii_columns.js
#    （把 xn_user 的 real_name/id_card/正反面照列加宽到加密后长度，否则密文写入会被截断）。
# ⚠️ 轮换本键必须走两步（审计 B-9）：①新钥填 PII_ENCRYPTION_KEY、旧钥填 PII_ENCRYPTION_KEY_PREVIOUS，
#    滚动重启（此时新写入用新钥、读取自动兼容旧钥）；②执行 node scripts/rotate-pii-key.js 把存量密文
#    重加密为当前钥；③确认脚本输出 remaining=0 后删除 PII_ENCRYPTION_KEY_PREVIOUS。
PII_ENCRYPTION_KEY=
# 轮换窗口内的上一把钥匙：只在轮换期间填写，留空表示没有旧钥（默认）。
PII_ENCRYPTION_KEY_PREVIOUS=

# ---- CORS / Rate Limit ----
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# 后台登录（/api/admin/login、/api/admin-manage/login）单 IP 每 15 分钟允许的尝试次数（审计 H-3）
ADMIN_LOGIN_RATE_LIMIT_MAX=5
# 同一管理员账号连续失败多少次后锁定 15 分钟（审计 H-3；Redis 键 admin:login:fail:<账号>）
ADMIN_LOGIN_MAX_FAILS=5
# 用户端登录单 IP 每 15 分钟允许的尝试次数（审计 M11）
LOGIN_RATE_LIMIT_MAX=20
# 验证码发送单 IP 每分钟次数（审计 H-8：开发环境不再自动豁免限流，本地联调频繁发码时调大此项）
SMS_RATE_LIMIT_MAX=1
# 一键放行全部限流，仅用于本地压测/排障（审计 H-8：生产环境设为 true 时后端直接拒绝启动）
RATE_LIMIT_DISABLED=false

# --- 反向代理信任层级（审计 H-8）---
# 「按 IP 计」的限流与访问日志都取 req.ip，是否采信 X-Forwarded-For 完全由本项决定；
# 该头可被客户端随意伪造，故默认只信任回环地址（仓库自带 nginx 与后端同机，默认值即可拿到真实 IP）。
# 可用取值：loopback / linklocal / unixsocket 及组合、单个跳数 1~10、IP 或 CIDR 网段（逗号分隔）；
# false=完全忽略 X-Forwarded-For。禁止 true / 星号 / all（配置解析层直接拒绝启动）。
TRUST_PROXY=loopback

# 认证黑名单查询失败时的策略：closed=拒绝请求（生产推荐）/ open=放行（本地开发默认）
AUTH_BLACKLIST_FAIL_MODE=closed
# 分享奖励每人每日上限（防刷）
SHARE_REWARD_DAILY_LIMIT=10

# ---- 存储（COS / QINIU 二选一） ----
# auto（默认）：配了下面任一远端就优先远端（cos→qiniu→oss），没配就本地
STORAGE_PROVIDER=auto
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# ---- 微信支付 ----
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=
# 微信商户平台「异步通知地址」必须指向本服务的 /api/pay/wx-notify（不是 /wx-callback）。
# 留空时服务端按 SERVER_URL 自动拼出该路径。
WECHAT_NOTIFY_URL=

# 微信登录（第三方登录用，必须配置，否则 /api/user/login-third 直接拒绝）
# 注意：这是小程序/公众号的 AppSecret，不是支付 API 密钥
WECHAT_APPSECRET=

# Apple 登录受众（iOS Bundle ID 或 Service ID；配置后会校验 identityToken 的 aud）
APPLE_CLIENT_ID=

# ⚠️ 仅本地联调：接受未经服务端反查的支付回执（默认关闭，生产严禁开启）
ALLOW_UNVERIFIED_PAY_CALLBACK=false

# ⚠️ 仅受控排障：按项豁免生产环境强制校验（逗号分隔的「检查项名」；留空或 false 表示不豁免）
# 可豁免项：JWT_SECRET, DB_PASSWORD, ADMIN_TOKEN, ADMIN_JWT_SECRET, PII_ENCRYPTION_KEY
# 不可豁免（始终强制）：CORS_ORIGIN, USE_MOCK_DB, RATE_LIMIT_DISABLED
# 注意：true/1/all/* 已不再表示「整体跳过」，会被拒绝且不豁免任何项；正常部署请保持 false
ALLOW_INSECURE_CONFIG=false
WECHAT_CERT_PATH=

# ---- 支付宝 ----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---- 短信 ----
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=eu搭子
SMS_TEMPLATE_ID=
SMS_NOTIFY_TEMPLATE_ID=

# ---- 音视频（TRTC） ----
TRTC_APP_ID=
TRTC_SECRET_KEY=

# ---- LLM 智能对话 ----
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
LLM_MAX_CONTEXT_MESSAGES=20

# ---- 虚拟人 ----
VIRTUAL_USER_CHAT_HISTORY_LIMIT=200

# ---- 其他 ----
USE_MOCK_DB=false
# 路由加载严格模式：true 时任何路由加载失败都会终止启动（默认仅告警）
STRICT_ROUTES=false
# 日志目录（默认 backend/logs）；非 production 默认打控制台，容器里建议设 LOG_TO_CONSOLE=true 让 docker logs 可见
LOGS_PATH=./logs
LOG_TO_CONSOLE=false
# 启动时自动执行迁移（默认执行；e2e 脚本等场景设 false 跳过）
AUTO_MIGRATE=true
# 宽列迁移（user_id/ip、实名字段，会触发表重建）：true/false 显式控制；
# 未设置时非生产执行、生产跳过（生产大表需维护窗口，跳过时按部署文档手工执行）
AUTO_MIGRATE_WIDEN_COLUMNS=true
# Swagger 文档：非 production 环境默认开启；生产需显式 true 才暴露 /api-docs
ENABLE_SWAGGER=false
# Swagger 文档中展示的生产服务器地址（仅文档用途）
SWAGGER_PROD_URL=https://api.eudazi.com

# ==================== 存储（支持多家组合，逗号分隔按优先级） ====================
# 例：STORAGE_PROVIDER=cos,qiniu,oss,local
# STORAGE_FALLBACK=false 时，链首失败直接报错（不降级）
#STORAGE_PROVIDER=local
#STORAGE_FALLBACK=true
#COS_SECRET_ID=
#COS_SECRET_KEY=
#COS_BUCKET=
#COS_REGION=ap-guangzhou
#QINIU_ACCESS_KEY=
#QINIU_SECRET_KEY=
#QINIU_BUCKET=
#QINIU_DOMAIN=
#OSS_ACCESS_KEY_ID=
#OSS_ACCESS_KEY_SECRET=
#OSS_BUCKET=
#OSS_REGION=
#OSS_ENDPOINT=
#OSS_DOMAIN=

# ==================== 通话通道（自建 WebRTC 为主，TRTC 为备选） ====================
# 通道策略：webrtc（默认，自建：Socket.IO 信令 + STUN/TURN）| trtc（腾讯云，需显式开启并配 TRTC_* 密钥）
#CALL_CHANNEL=webrtc
#STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ---- TURN 中继（自建 WebRTC 在对称 NAT 下必需）----
# 采用 coturn REST API 模式（--use-auth-secret）：只配 URL + 共享密钥，
# 凭据由后端按用户临时签发（见 src/services/callConfigService.js），
# 前端包体中不出现长期密钥。TURN_SECRET 必须与 docker-compose 的 coturn 一致。
# 生成密钥：openssl rand -hex 32
#TURN_URL=turn:turn.example.com:3478
#TURN_SECRET=
#TURN_TTL=3600

# ==================== LLM（虚拟人对话，OpenAI 兼容） ====================
#LLM_ENABLED=true
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_MODEL=deepseek-chat
#LLM_API_KEY=

# ==================== 备份脚本（scripts/backup.js，可选覆盖） ====================
# 默认存 backend/backups、保留 7 天；docker 模式凭证取自根 .env
#BACKUP_DIR=./backups
#BACKUP_MODE=docker
#BACKUP_TARGET=all
#BACKUP_RETENTION_DAYS=7

# 测试/演示：短信通道未配置时把随机验证码回传给前端自动填入（默认关闭，仅限内测）
# SMS_TEST_PHONES 非空时只对白名单手机号生效；留空=全部手机号（高风险）
SMS_TEST_MODE=false
SMS_TEST_PHONES=
