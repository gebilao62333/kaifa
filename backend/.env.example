# 后端环境变量模板
# 本地开发：复制为 backend/.env（server.js 从 backend/.env 加载）
# Docker 部署：由根目录 .env 通过 env_file 注入，无需此文件
# DB_HOST 等容器地址（mysql/redis/mongo）仅 Docker 内有效，本地开发改为 127.0.0.1（端口见 docker-compose.yml 映射）

PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=eudazi
DB_USER=admin
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4
DB_POOL_MAX=10
DB_POOL_MIN=0

# ---- MongoDB ----
MONGO_URI=mongodb://admin:changeme@127.0.0.1:27017/eudazi?authSource=admin

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=changeme

# ---- JWT / Auth ----
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_TOKEN=changeme
# 应急登录：仅当设为 true 时，数据库不可用才允许用 ADMIN_TOKEN 应急登录（默认关闭，生产慎用）
ADMIN_EMERGENCY_LOGIN=false

# ---- CORS / Rate Limit ----
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# 认证黑名单查询失败时的策略：closed=拒绝请求（生产推荐）/ open=放行（本地开发默认）
AUTH_BLACKLIST_FAIL_MODE=closed
# 分享奖励每人每日上限（防刷）
SHARE_REWARD_DAILY_LIMIT=10

# ---- 存储（COS / QINIU 二选一） ----
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# ---- 微信支付 ----
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=

# 微信登录（第三方登录用，必须配置，否则 /api/user/login-third 直接拒绝）
# 注意：这是小程序/公众号的 AppSecret，不是支付 API 密钥
WECHAT_APPSECRET=

# Apple 登录受众（iOS Bundle ID 或 Service ID；配置后会校验 identityToken 的 aud）
APPLE_CLIENT_ID=

# ⚠️ 仅本地联调：接受未经服务端反查的支付回执（默认关闭，生产严禁开启）
ALLOW_UNVERIFIED_PAY_CALLBACK=false

# ⚠️ 仅受控排障：跳过生产环境密钥强制校验（默认关闭，生产严禁开启）
ALLOW_INSECURE_CONFIG=false
WECHAT_CERT_PATH=

# ---- 支付宝 ----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---- 短信 ----
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=eu搭子
SMS_TEMPLATE_ID=
SMS_NOTIFY_TEMPLATE_ID=

# ---- 音视频（TRTC） ----
TRTC_APP_ID=
TRTC_SECRET_KEY=

# ---- LLM 智能对话 ----
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
LLM_MAX_CONTEXT_MESSAGES=20

# ---- 虚拟人 ----
VIRTUAL_USER_CHAT_HISTORY_LIMIT=200

# ---- 其他 ----
USE_MOCK_DB=false
# 路由加载严格模式：true 时任何路由加载失败都会终止启动（默认仅告警）
STRICT_ROUTES=false

# ==================== 存储（支持多家组合，逗号分隔按优先级） ====================
# 例：STORAGE_PROVIDER=cos,qiniu,oss,local
# STORAGE_FALLBACK=false 时，链首失败直接报错（不降级）
#STORAGE_PROVIDER=local
#STORAGE_FALLBACK=true
#COS_SECRET_ID=
#COS_SECRET_KEY=
#COS_BUCKET=
#COS_REGION=ap-guangzhou
#QINIU_ACCESS_KEY=
#QINIU_SECRET_KEY=
#QINIU_BUCKET=
#QINIU_DOMAIN=
#OSS_ACCESS_KEY_ID=
#OSS_ACCESS_KEY_SECRET=
#OSS_BUCKET=
#OSS_REGION=
#OSS_ENDPOINT=
#OSS_DOMAIN=

# ==================== 通话通道（自建 WebRTC 为主，TRTC 为备选） ====================
# 通道策略：webrtc（默认，自建：Socket.IO 信令 + STUN/TURN）| trtc（腾讯云，需显式开启并配 TRTC_* 密钥）
#CALL_CHANNEL=webrtc
#STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ---- TURN 中继（自建 WebRTC 在对称 NAT 下必需）----
# 采用 coturn REST API 模式（--use-auth-secret）：只配 URL + 共享密钥，
# 凭据由后端按用户临时签发（见 src/services/callConfigService.js），
# 前端包体中不出现长期密钥。TURN_SECRET 必须与 docker-compose 的 coturn 一致。
# 生成密钥：openssl rand -hex 32
#TURN_URL=turn:turn.example.com:3478
#TURN_SECRET=
#TURN_TTL=3600

# ==================== LLM（虚拟人对话，OpenAI 兼容） ====================
#LLM_ENABLED=true
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_MODEL=deepseek-chat
#LLM_API_KEY=
