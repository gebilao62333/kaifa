# 后端环境变量模板
# 本地开发：复制为 backend/.env（server.js 从 backend/.env 加载）
# Docker 部署：由根目录 .env 通过 env_file 注入，无需此文件
# DB_HOST 等容器地址（mysql/redis/mongo）仅 Docker 内有效，本地开发改为 127.0.0.1（端口见 docker-compose.yml 映射）

PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=eudazi
DB_USER=admin
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4

MONGO_URI=mongodb://admin:changeme@127.0.0.1:27017/eudazi?authSource=admin

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=changeme

JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_TOKEN=changeme

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=

SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=

TRTC_APP_ID=
TRTC_SECRET_KEY=

LOGS_PATH=./logs
LOG_TO_CONSOLE=false
USE_MOCK_DB=false

# 路由加载严格模式：true 时任何路由加载失败都会终止启动（默认仅告警）
STRICT_ROUTES=false
