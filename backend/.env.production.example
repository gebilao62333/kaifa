# 生产环境环境变量模板
# 复制为 .env.production 并填入真实值
# 所有 changeme / 空值 必须替换，否则服务存在安全风险

PORT=3000
NODE_ENV=production
SERVER_URL=https://your-domain.com

# ---- MySQL ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eudazi
DB_USER=eudazi_prod
DB_PASSWORD=<openssl rand -hex 24>
DB_CHARSET=utf8mb4
DB_POOL_MAX=30
DB_POOL_MIN=5

# ---- MongoDB ----
MONGO_URI=mongodb://eudazi_prod:<password>@mongo:27017/eudazi?authSource=admin

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<openssl rand -hex 24>

# ---- JWT / Auth ----
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# 管理端访问令牌时效（审计 M-2：默认 12h；后台权限/状态每次请求实时回读数据库，这里决定凭令牌本身还能活多久，支持 s/m/h/d）
ADMIN_JWT_EXPIRES_IN=12h
# 管理端令牌独立签名密钥（审计 M-3）。生产建议显式设置（如 <openssl rand -hex 32>），
# 留空时由 JWT_SECRET 派生——两类令牌仍互不通用，但不构成「用户端密钥泄露不影响管理端」的隔离
ADMIN_JWT_SECRET=<openssl rand -hex 32>
ADMIN_TOKEN=<openssl rand -hex 32>
ADMIN_EMERGENCY_LOGIN=false
# 应急登录账号（仅应急开关开启且数据库不可用时生效；登录后立即创建正式管理员）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 实名信息（真实姓名/身份证号/正反面照）静态加密密钥（审计 M-8）[必改]
# 生成命令：openssl rand -hex 32。生产环境未设置或为弱值时后端拒绝启动。
# 上线顺序：先执行迁移 backend/src/migrations/20261004000002_widen_pii_columns.js（加宽 xn_user 相关列），
#          再配置本键并重启后端；顺序反了会把密文写进宽度不足的列而被截断。
# 本键不可随意更换：换键后历史密文无法解密（无密钥轮换机制，属遗留）。
PII_ENCRYPTION_KEY=<openssl rand -hex 32>

# ---- CORS / Rate Limit ----
CORS_ORIGIN=https://your-frontend-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# 后台登录（/api/admin/login、/api/admin-manage/login）单 IP 每 15 分钟允许的尝试次数（审计 H-3）
ADMIN_LOGIN_RATE_LIMIT_MAX=5
# 同一管理员账号连续失败多少次后锁定 15 分钟（审计 H-3；Redis 键 admin:login:fail:<账号>）
ADMIN_LOGIN_MAX_FAILS=5
# 用户端登录单 IP 每 15 分钟允许的尝试次数（审计 M11）
LOGIN_RATE_LIMIT_MAX=20
# 验证码发送单 IP 每分钟次数
SMS_RATE_LIMIT_MAX=1
# 生产环境必须为 false：设为 true 时后端启动校验会直接拒绝启动（审计 H-8）
RATE_LIMIT_DISABLED=false

# --- 反向代理信任层级（审计 H-8）---
# 「按 IP 计」的限流与访问日志都取 req.ip，本项决定是否采信可被客户端伪造的 X-Forwarded-For。
# 默认 loopback 适配与后端同机的 nginx（upstream 走 127.0.0.1）；nginx / 网关在另一台机器时
# 必须显式声明它的网段（如 TRUST_PROXY=loopback,10.0.0.0/8），否则 req.ip 会是那一跳代理的地址。
# 不建议用跳数（如 TRUST_PROXY=1）：跳数只按「链上数几个」放行、不校验对端来源，直连后端者仍可伪造 XFF
# 绕过限流 —— 这正是审计 H-8 的原始形态。跳数 1~10 语法上合法，仅在确实拿不到反代网段时退而求其次。
# 禁止填 true / 星号 / all / 0.0.0.0/0：等于允许任意直连请求伪造 IP 绕过限流，配置解析层会拒绝启动。
# 主机位非零的网段（如 123.45.67.89/24，proxy-addr 会静默掩成整段）同样拒绝启动，请写规范网络地址或 /32。
TRUST_PROXY=loopback

# 认证黑名单查询失败时的策略：closed=拒绝请求（生产推荐）/ open=放行（本地开发默认）
AUTH_BLACKLIST_FAIL_MODE=closed
# 分享奖励每人每日上限（防刷）
SHARE_REWARD_DAILY_LIMIT=10

# ---- 存储（COS / 七牛 / 阿里云 OSS 多家可组合：逗号分隔按优先级） ----
STORAGE_PROVIDER=cos
# 链首失败是否继续尝试下一家（默认 true）；false=失败即报错
STORAGE_FALLBACK=true
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_DOMAIN=

# ---- 微信支付 ----
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=
# 商户平台「异步通知地址」填同一个值：必须指向 /api/pay/wx-notify（不是 /wx-callback）
WECHAT_NOTIFY_URL=https://your-domain.com/api/pay/wx-notify

# 微信登录（第三方登录用，必须配置，否则 /api/user/login-third 直接拒绝）
# 注意：这是小程序/公众号的 AppSecret，不是支付 API 密钥
WECHAT_APPSECRET=

# Apple 登录受众（iOS Bundle ID 或 Service ID；配置后会校验 identityToken 的 aud）
APPLE_CLIENT_ID=

# ⚠️ 仅本地联调：接受未经服务端反查的支付回执（默认关闭，生产严禁开启）
ALLOW_UNVERIFIED_PAY_CALLBACK=false

# ⚠️ 仅受控排障：按项豁免生产环境强制校验（逗号分隔的「检查项名」；留空或 false 表示不豁免）
# 可豁免项：JWT_SECRET, DB_PASSWORD, ADMIN_TOKEN, ADMIN_JWT_SECRET, PII_ENCRYPTION_KEY
# 不可豁免（始终强制）：CORS_ORIGIN, USE_MOCK_DB, RATE_LIMIT_DISABLED
# 注意：true/1/all/* 已不再表示「整体跳过」，会被拒绝且不豁免任何项；正常部署请保持 false
ALLOW_INSECURE_CONFIG=false
WECHAT_CERT_PATH=/app/cert/wechat/apiclient_cert.pem

# ---- 支付宝 ----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---- 短信 ----
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=eu搭子
SMS_TEMPLATE_ID=
SMS_NOTIFY_TEMPLATE_ID=

# ---- 通话通道（自建 WebRTC 为主，TRTC 为备选） ----
# webrtc（默认）| trtc（需同时配置下面的 TRTC_APP_ID/SECRET_KEY）
CALL_CHANNEL=webrtc
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ---- 音视频（TRTC，仅 CALL_CHANNEL=trtc 时需要） ----
TRTC_APP_ID=
TRTC_SECRET_KEY=

# ---- TURN 中继（docker compose --profile turn 时使用） ----
# coturn REST API 模式：凭据由后端按用户临时签发，前端不持有长期密钥。
# 启用 turn profile 前必须替换 TURN_SECRET（openssl rand -hex 32），并保持与 coturn 启动密钥一致；
# 未设置时 coturn 会以公开占位密钥启动，可被冒签中继凭据（启动自检会告警）。
TURN_URL=
TURN_SECRET=
TURN_TTL=3600

# ---- LLM 智能对话 ----
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
LLM_MAX_CONTEXT_MESSAGES=20

# ---- 虚拟人 ----
VIRTUAL_USER_CHAT_HISTORY_LIMIT=200

# ---- 其他 ----
USE_MOCK_DB=false
STRICT_ROUTES=true
# 日志目录；生产建议用绝对路径并由卷持久化；LOG_TO_CONSOLE=true 让容器 stdout 可见
LOGS_PATH=/var/log/eudazi
LOG_TO_CONSOLE=true
# 启动时自动执行迁移（默认执行；不需要时设 false）
AUTO_MIGRATE=true
# 宽列迁移（user_id/ip、实名字段，会触发表重建）：生产默认跳过（本值显式关闭）；
# 上线窗口内确认可重建表后再改 true，或按部署文档手工执行两个迁移
AUTO_MIGRATE_WIDEN_COLUMNS=false
# Swagger 文档：生产默认关闭，true 才暴露 /api-docs（不建议对公网开放）
ENABLE_SWAGGER=false
# Swagger 文档中展示的生产服务器地址（仅文档用途）
SWAGGER_PROD_URL=https://your-domain.com

# ---- 备份脚本（scripts/backup.js，可选覆盖） ----
#BACKUP_DIR=./backups
#BACKUP_MODE=docker
#BACKUP_TARGET=all
#BACKUP_RETENTION_DAYS=7

# 测试/演示：短信通道未配置时把随机验证码回传给前端自动填入（默认关闭，仅限内测）
# SMS_TEST_PHONES 非空时只对白名单手机号生效；留空=全部手机号（高风险）
SMS_TEST_MODE=false
SMS_TEST_PHONES=
