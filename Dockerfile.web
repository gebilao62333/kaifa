# ============================================
# eu搭子 Web 镜像（H5 用户端 + 管理后台 + Nginx 反向代理）
# 用于 Sealos「应用管理」：一个镜像同时提供 /、/admin、/api、/socket.io、/uploads
#
# 构建（仓库根目录）：
#   docker build -f Dockerfile.web -t <registry>/eudazi-web:v1 .
# ============================================

# ---------- 1. 构建新版用户端 H5（app/，uni-app）----------
FROM node:24-alpine AS app-build
WORKDIR /build

# 依赖层（pnpm）
RUN npm install -g pnpm@10.15.0
COPY app/package.json app/pnpm-lock.yaml app/pnpm-workspace.yaml app/.npmrc ./
RUN pnpm install --frozen-lockfile --reporter=append-only

COPY app/ ./
# 同源部署：VITE_API_ORIGIN 留空，走 nginx /api 反代
RUN pnpm build:h5

# ---------- 2. 构建管理后台（admin-frontend/）----------
FROM node:24-alpine AS admin-build
WORKDIR /build
COPY admin-frontend/package.json admin-frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY admin-frontend/ ./
RUN npm run build

# ---------- 3. Nginx 运行时 ----------
FROM nginx:1.26-alpine

# 模板里的 ${BACKEND_HOST}/${BACKEND_PORT} 由官方 entrypoint 的 envsubst 注入
ENV BACKEND_HOST=backend \
    BACKEND_PORT=3000

COPY deploy/sealos/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=app-build /build/dist/build/h5 /usr/share/nginx/html
COPY --from=admin-build /build/dist /usr/share/nginx/admin

# 替换官方默认 server 配置
RUN rm -f /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
