# =============================================================
#  生产环境配置模板 — 部署前必须修改所有标记为 [必改] 的项
# =============================================================
#  使用方法：
#    1. 复制此文件为 .env（docker-compose.yml 通过 env_file 读取根目录 .env）
#    2. 替换所有占位值与 [必改] 项为实际值
#    3. docker-compose up -d --build
#
#  ⚠️ 变量名必须与代码读取的键完全一致（backend/src/config/index.js）。
#     2026-10-03 修正：微信支付/短信/TRTC 曾写成 WX_*/SMS_ACCESS_KEY_*/TRTC_SDK_*，
#     代码根本不读这些键，照抄模板会导致支付、短信、音视频静默不可用。
# =============================================================

# ===== 服务 =====
PORT=3000
NODE_ENV=production
USE_MOCK_DB=false
SERVER_URL=https://your-domain.com
LOGS_PATH=/var/log/eudazi
# 容器部署下让日志同时打到 stdout（docker logs 可见；compose 已注入同值）
LOG_TO_CONSOLE=true

# ===== JWT 密钥 [必改] =====
# 生成命令: openssl rand -hex 32
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# 管理端访问令牌时效（审计 M-2：默认 12h）
ADMIN_JWT_EXPIRES_IN=12h

# ===== 后台管理 Token [必改] =====
# 生成命令: openssl rand -hex 32；该值等同于超级管理员身份，泄漏即失守
ADMIN_TOKEN=<openssl rand -hex 32>

# ===== 管理端令牌独立签名密钥 [必改]（审计 M-3）=====
# 生成命令: openssl rand -hex 32。留空时由 JWT_SECRET 派生一个不同的密钥——两类令牌仍互不通用，
# 但不构成「用户端密钥泄露不影响管理端」的隔离；生产建议显式设置本项
ADMIN_JWT_SECRET=<openssl rand -hex 32>

# ===== 实名信息静态加密密钥 [必改]（审计 M-8）=====
# 生成命令: openssl rand -hex 32。加密 xn_user 的真实姓名/身份证号/正反面照（AES-256-GCM，见 utils/pii.js）。
# 生产环境未设置或为弱值时后端拒绝启动。上线顺序：先执行迁移
# backend/src/migrations/20261004000002_widen_pii_columns.js（加宽相关列），再配置本键并重启，顺序反了会截断密文。
# 本键不可随意更换：换键后历史密文无法解密（无密钥轮换机制，属遗留）。
PII_ENCRYPTION_KEY=<openssl rand -hex 32>

# ===== 管理员应急登录（首次部署引导用，默认关闭）=====
# 首次部署时数据库里还没有可用的管理员账号，可临时开启本开关，
# 用下面的账号密码登录后台 → 创建正式管理员 → 立即改回 false。
# 关闭时（默认）即使配置了账号密码也无法通过环境变量登录。
ADMIN_EMERGENCY_LOGIN=false
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=<openssl rand -hex 24>
MYSQL_DATABASE=eudazi
MYSQL_USER=eudazi
MYSQL_PASSWORD=<openssl rand -hex 24>

# ===== MongoDB =====
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<openssl rand -hex 24>
# 应用账号（mongo/init.js 创建；compose 启动必需）
MONGO_APP_USER=eudazi
MONGO_APP_PASSWORD=<openssl rand -hex 24>
MONGO_DATABASE=eudazi

# ===== Redis =====
REDIS_PASSWORD=<openssl rand -hex 24>

# ===== 后端连接配置（Docker Compose 内部使用服务名）=====
DB_HOST=mysql
DB_PORT=3306
DB_USER=eudazi
DB_PASSWORD=<openssl rand -hex 24>
DB_NAME=eudazi
DB_CHARSET=utf8mb4
DB_POOL_MAX=30
DB_POOL_MIN=5
MONGO_URI=mongodb://admin:<mongo-password>@mongo:27017/eudazi?authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<openssl rand -hex 24>

# ===== CORS [必改] =====
# 生产环境必须填具体前端域名（逗号分隔多个），禁止使用 *
CORS_ORIGIN=https://your-domain.com

# ===== 对象存储（COS / 七牛 / 阿里云 OSS 多家组合：逗号分隔按优先级）=====
# 未配置远端存储时，文件上传回退到后端本地存储
STORAGE_PROVIDER=cos
# 链首失败是否继续尝试下一家（默认 true）；false=失败即报错
STORAGE_FALLBACK=true
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_DOMAIN=

# ===== 通话通道（自建 WebRTC 为主，TRTC 为备选）=====
# webrtc（默认）| trtc（需同时配置下面的 TRTC_APP_ID/SECRET_KEY）
CALL_CHANNEL=webrtc
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ===== 腾讯云 TRTC (音视频通话，仅 CALL_CHANNEL=trtc 时需要) =====
TRTC_APP_ID=
TRTC_SECRET_KEY=

# ===== TURN 中继（docker compose --profile turn 时使用）=====
# coturn REST API 模式：凭据由后端按用户临时签发，前端不持有长期密钥。
# ⚠️ 启用 turn profile 前必须替换 TURN_SECRET（openssl rand -hex 32），并保持与 coturn 启动密钥一致；
#    未设置时 coturn 会以公开占位密钥启动，可被冒签中继凭据（后端启动自检会告警）。
TURN_REALM=eudazi
TURN_SECRET=<openssl rand -hex 32>
TURN_EXTERNAL_IP=<服务器公网 IP>
# 后端签发给前端的 TURN 地址与凭据有效期（秒）；例如 turn:your-domain.com:3478
TURN_URL=
TURN_TTL=3600

# ===== 微信支付 =====
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_KEY=

# 微信登录（第三方登录用，必须配置，否则 /api/user/login-third 直接拒绝）
# 注意：这是小程序/公众号的 AppSecret，不是支付 API 密钥
WECHAT_APPSECRET=

# Apple 登录受众（iOS Bundle ID 或 Service ID；配置后会校验 identityToken 的 aud）
APPLE_CLIENT_ID=

# ⚠️ 仅本地联调：接受未经服务端反查的支付回执（默认关闭，生产严禁开启）
ALLOW_UNVERIFIED_PAY_CALLBACK=false

# ⚠️ 仅受控排障：按项豁免生产环境强制校验（逗号分隔的「检查项名」；留空或 false 表示不豁免）
# 可豁免项：JWT_SECRET, DB_PASSWORD, ADMIN_TOKEN, ADMIN_JWT_SECRET, PII_ENCRYPTION_KEY
# 不可豁免（始终强制）：CORS_ORIGIN, USE_MOCK_DB, RATE_LIMIT_DISABLED
# 注意：true/1/all/* 已不再表示「整体跳过」，会被拒绝且不豁免任何项；正常部署请保持 false
ALLOW_INSECURE_CONFIG=false
WECHAT_CERT_PATH=/app/cert/wechat/apiclient_cert.pem
# 支付回调地址；留空则回退 ${SERVER_URL}/api/pay/wx-notify
WECHAT_NOTIFY_URL=https://your-domain.com/api/pay/wx-notify

# ===== 支付宝支付 =====
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ===== 腾讯云短信 =====
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=eu搭子
SMS_TEMPLATE_ID=
SMS_NOTIFY_TEMPLATE_ID=

# ===== LLM 智能对话（虚拟用户）=====
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
LLM_MAX_CONTEXT_MESSAGES=20

# ===== 虚拟人 =====
VIRTUAL_USER_CHAT_HISTORY_LIMIT=200

# ===== 限流 =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# 后台登录单 IP 每 15 分钟的尝试次数（审计 H-3）
ADMIN_LOGIN_RATE_LIMIT_MAX=5
# 同一管理员账号连续失败多少次后锁定 15 分钟（审计 H-3）
ADMIN_LOGIN_MAX_FAILS=5
# 用户端登录单 IP 每 15 分钟允许的尝试次数（审计 M11）
LOGIN_RATE_LIMIT_MAX=20
# 验证码发送单 IP 每分钟次数
SMS_RATE_LIMIT_MAX=1
# 生产环境必须为 false：设为 true 时后端启动校验会直接拒绝启动（审计 H-8）
RATE_LIMIT_DISABLED=false

# ===== 反向代理信任层级（审计 H-8）=====
# 「按 IP 计」的限流与访问日志都取 req.ip，本项决定是否采信可被客户端伪造的 X-Forwarded-For。
# ⚠️ 本文件由根目录 .env 提供，同时是 docker-compose.yml 的插值来源：该编排里 nginx 是**独立容器**，
#    与 backend 走 eudazi_net 的 bridge 网段通信，所以这里必须带上该网段（与 compose 的默认值一致）。
#    写成 loopback 会让后端把 nginx 容器地址当成唯一来源，全站共用一个限流桶。
# 手工部署（nginx 与后端同机、upstream 走 127.0.0.1）→ 用 loopback 即可。
# 反代在另一台机器（云 LB / K8s ingress / 跨机 nginx）→ 必须显式加它的网段，例如
#    TRUST_PROXY=loopback,172.16.0.0/12,10.0.0.0/8，否则 req.ip 会是那一跳代理的地址。
#    不建议用跳数（如 TRUST_PROXY=1）：跳数只按「链上数几个」放行，不校验对端是谁，
#    直连后端的请求仍可伪造 XFF 绕过限流——这正是审计 H-8 的原始形态。
# 禁止填 true / 星号 / all / 0.0.0.0/0：那等于允许任意直连请求伪造 IP 绕过限流，配置解析层会拒绝启动。
# 主机位非零的网段（如 123.45.67.89/24）同样拒绝启动，请写成规范网络地址或 /32。
TRUST_PROXY=loopback,172.16.0.0/12

# 认证黑名单查询失败时的策略：closed=拒绝请求（生产推荐）/ open=放行（本地开发默认）
AUTH_BLACKLIST_FAIL_MODE=closed
# 分享奖励每人每日上限（防刷）
SHARE_REWARD_DAILY_LIMIT=10

# ===== 启动与调试 =====
# 启动时自动执行迁移（默认执行；e2e 脚本等场景设 false 跳过）
AUTO_MIGRATE=true
# 宽列迁移（user_id/ip、实名字段，会触发表重建）：生产默认跳过（本值显式关闭）；
# 上线窗口内确认可重建表后再改 true，或按部署文档手工执行两个迁移
AUTO_MIGRATE_WIDEN_COLUMNS=false
# Swagger 文档：生产默认关闭，true 才暴露 /api-docs（不建议对公网开放）
ENABLE_SWAGGER=false
# Swagger 文档中展示的生产服务器地址（仅文档用途）
SWAGGER_PROD_URL=https://your-domain.com

# ===== 备份脚本（backend/scripts/backup.js，可选覆盖）=====
#BACKUP_DIR=./backups
#BACKUP_MODE=docker
#BACKUP_TARGET=all
#BACKUP_RETENTION_DAYS=7

# ===== 启动严格模式 =====
# true：任一业务路由模块加载失败即终止启动（生产建议 true，避免接口静默 404）
STRICT_ROUTES=true
