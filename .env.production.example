# =============================================================
#  生产环境配置模板 — 部署前必须修改所有标记为 [必改] 的项
# =============================================================
#  使用方法：
#    1. 复制此文件为 .env（或 docker-compose 引用的环境文件）
#    2. 替换所有占位值与 [必改] 项为实际值
#    3. docker-compose up -d
# =============================================================

# ===== 关闭 mock，启用真实数据库 =====
USE_MOCK_DB=false

# ===== JWT 密钥 [必改] =====
# 生成命令: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=eudazi
MYSQL_USER=eudazi
MYSQL_PASSWORD=change-me-db-password

# ===== MongoDB =====
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-mongo-password
MONGO_DATABASE=eudazi

# ===== Redis =====
REDIS_PASSWORD=change-me-redis-password

# ===== 后端连接配置（Docker Compose 内部使用服务名）=====
DB_HOST=mysql
DB_PORT=3306
DB_USER=eudazi
DB_PASSWORD=change-me-db-password
DB_NAME=eudazi
MONGO_URI=mongodb://admin:change-me-mongo-password@mongo:27017/eudazi?authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# ===== 后台管理 Token [必改] =====
ADMIN_TOKEN=change-me-admin-token
# 应急登录：仅当 true 时数据库不可用才允许 ADMIN_USERNAME/ADMIN_PASSWORD 登录（默认关闭，生产慎用）
ADMIN_EMERGENCY_LOGIN=false

# ===== CORS [必改] =====
# 生产环境改为实际域名，如: https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ===== 腾讯云 COS (对象存储) =====
# 不配置 COS 时，文件上传回退到后端本地存储
STORAGE_PROVIDER=cos
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou

# ===== 腾讯云 TRTC (音视频通话) =====
# TRTC_SDK_APP_ID=1400000000
# TRTC_SECRET_KEY=your-trtc-secret-key
# TRTC_SDK_SECRET_KEY=your-trtc-sdk-secret-key

# ===== 微信支付 =====
# WX_APP_ID=your-wx-app-id
# WX_MCH_ID=your-wx-mch-id
# WX_API_KEY=your-wx-api-key
# WX_NOTIFY_URL=https://your-domain.com/api/pay/wx-notify

# ===== 支付宝支付 =====
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PRIVATE_KEY=your-alipay-private-key
# ALIPAY_PUBLIC_KEY=your-alipay-public-key

# ===== 短信服务 =====
# SMS_ACCESS_KEY_ID=your-sms-key
# SMS_ACCESS_KEY_SECRET=your-sms-secret
# SMS_SIGN_NAME=eu搭子
# SMS_TEMPLATE_CODE=SMS_0000000

# ===== 限流配置 =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
