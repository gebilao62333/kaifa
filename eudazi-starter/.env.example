# ===== 基础运行配置 =====
# 服务监听端口
PORT=3000
# 运行环境：development | production
NODE_ENV=development

# CORS 允许来源，'*' 表示允许所有（演示用）。生产建议改为具体域名，如 https://duoke.com
CORS_ORIGIN=*

# ===== JWT 配置 =====
# 令牌签名密钥，生产环境务必替换为强随机字符串
JWT_SECRET=duoke-dev-secret-key-2026
# 令牌有效期
JWT_EXPIRES_IN=7d

# ===== 后台管理员账号（演示用，生产请修改）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 应急固定令牌（可选）：配置后可用该字符串直接作为 x-admin-token 调用后台接口
# 留空则不启用
ADMIN_TOKEN=
